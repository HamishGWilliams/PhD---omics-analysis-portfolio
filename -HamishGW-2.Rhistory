}
# Combine results
all_res <- bind_rows(GSEA_BP, GSEA_MF)
# Extra validation after combining
if (nrow(all_res) == 0) {
message("Skipping ", region_type, " — combined result is empty.")
next
}
if (!all(all_res$region == region_type)) {
warning("Combined results contain incorrect region values for ", region_type, ". Skipping.")
next
}
# Filter significant results
sig_res <- all_res %>%
filter(!is.na(p.adjust), p.adjust < 0.1)
if (nrow(sig_res) == 0) {
message("No significant terms after p.adjust filtering for ", region_type)
next
}
# Extract methylation differences per core enrichment
sig_res <- sig_res %>%
rowwise() %>%
mutate(
methDiff_combined = get_methDiff_data(core_enrichment, region_data)
) %>%
ungroup()
# Add split columns
sig_res <- sig_res %>%
mutate(
Gene_IDs_list = strsplit(as.character(core_enrichment), "/"),
MethDiff_list = strsplit(as.character(methDiff_combined), "/")
)
# Final safety check before storing
if (!all(sig_res$region == region_type)) {
warning("Final significant results contain incorrect region values for ", region_type, ". Skipping.")
next
}
# Store safely in list rather than rbind in loop
GSEA_exp1_results_list[[region_type]] <- sig_res
}
library(dplyr)
library(tibble)
# Make a list to store per-region results safely
GSEA_exp1_results_list <- list()
library(dplyr)
library(tibble)
run_region_gsea <- function(
dm_region_data,
GENES_BP,
TERMs_BP,
GENES_MF,
TERMs_MF,
region_col = "region",
score_col = 7,
gene_col = 19,
min_genes = 50,
pvalue_cutoff = 1,
padj_cutoff = 0.1,
seed = 100,
add_methdiff = TRUE
) {
# -----------------------------
# Safety checks
# -----------------------------
if (!region_col %in% names(dm_region_data)) {
stop("region_col not found in dm_region_data")
}
if (is.character(score_col) && !score_col %in% names(dm_region_data)) {
stop("score_col not found in dm_region_data")
}
if (is.character(gene_col) && !gene_col %in% names(dm_region_data)) {
stop("gene_col not found in dm_region_data")
}
score_vec <- if (is.numeric(score_col)) dm_region_data[[score_col]] else dm_region_data[[score_col]]
gene_vec  <- if (is.numeric(gene_col))  dm_region_data[[gene_col]]  else dm_region_data[[gene_col]]
if (length(score_vec) != nrow(dm_region_data) || length(gene_vec) != nrow(dm_region_data)) {
stop("score_col or gene_col does not map cleanly onto dm_region_data rows")
}
# only use observed region values
region_values <- dm_region_data[[region_col]] %>%
as.character() %>%
trimws()
region_values <- sort(unique(region_values[!is.na(region_values) & region_values != ""]))
if (length(region_values) == 0) {
stop("No usable region values found")
}
# -----------------------------
# Internal helper to run one GSEA
# -----------------------------
run_one_gsea <- function(geneList, TERM2GENE, TERM2NAME, ontology_label, region_type) {
res <- tryCatch(
{
set.seed(seed)
GSEA(
geneList = geneList,
TERM2GENE = TERM2GENE,
TERM2NAME = TERM2NAME,
pvalueCutoff = pvalue_cutoff
)
},
error = function(e) {
message("  ", ontology_label, " failed for ", region_type, ": ", conditionMessage(e))
NULL
}
)
if (is.null(res)) {
return(NULL)
}
if (is.null(res@result) || nrow(res@result) == 0) {
message("  ", ontology_label, ": no results for ", region_type)
return(NULL)
}
out <- as_tibble(res@result) %>%
mutate(
GO = ontology_label,
region = region_type
)
if (!is.null(padj_cutoff) && "p.adjust" %in% names(out)) {
out <- out %>%
filter(!is.na(p.adjust), p.adjust < padj_cutoff)
}
if (nrow(out) == 0) {
message("  ", ontology_label, ": no results pass p.adjust cutoff for ", region_type)
return(NULL)
}
# final check
if (!all(out$region == region_type)) {
stop("Region assignment check failed for ", region_type, " (", ontology_label, ")")
}
out
}
# -----------------------------
# Loop over regions
# -----------------------------
results_list <- vector("list", length(region_values))
names(results_list) <- region_values
for (i in seq_along(region_values)) {
region_type <- region_values[i]
message("Processing region: ", region_type)
region_idx <- trimws(as.character(dm_region_data[[region_col]])) == region_type
region_data <- dm_region_data[region_idx, , drop = FALSE]
if (nrow(region_data) == 0) {
message("  No rows found for ", region_type)
next
}
# explicit validation that subset contains only one region
region_check <- unique(trimws(as.character(region_data[[region_col]])))
region_check <- region_check[!is.na(region_check) & region_check != ""]
if (length(region_check) != 1 || region_check != region_type) {
stop("Subset validation failed for region ", region_type)
}
# Build ranked gene table
gene_tbl <- tibble(
gene_id = trimws(as.character(region_data[[gene_col]])),
score   = suppressWarnings(as.numeric(region_data[[score_col]]))
) %>%
filter(!is.na(gene_id), gene_id != "", !is.na(score)) %>%
group_by(gene_id) %>%
summarise(
score = score[which.max(abs(score))],
.groups = "drop"
) %>%
arrange(desc(score))
if (nrow(gene_tbl) < min_genes) {
message("  Skipping ", region_type, " — only ", nrow(gene_tbl), " usable genes")
next
}
geneList <- gene_tbl$score
names(geneList) <- gene_tbl$gene_id
geneList <- sort(geneList, decreasing = TRUE)
if (length(geneList) != length(unique(names(geneList)))) {
stop("Duplicate gene names remain in geneList for ", region_type)
}
bp_res <- run_one_gsea(
geneList = geneList,
TERM2GENE = GENES_BP,
TERM2NAME = TERMs_BP,
ontology_label = "biological_processes",
region_type = region_type
)
mf_res <- run_one_gsea(
geneList = geneList,
TERM2GENE = GENES_MF,
TERM2NAME = TERMs_MF,
ontology_label = "molecular_function",
region_type = region_type
)
region_results <- bind_rows(bp_res, mf_res)
if (nrow(region_results) == 0) {
message("  No GSEA results retained for ", region_type)
next
}
# optional methDiff extraction
if (isTRUE(add_methdiff) &&
exists("get_methDiff_data", mode = "function") &&
"core_enrichment" %in% names(region_results)) {
region_results <- region_results %>%
rowwise() %>%
mutate(
methDiff_combined = get_methDiff_data(core_enrichment, region_data)
) %>%
ungroup() %>%
mutate(
Gene_IDs_list = strsplit(as.character(core_enrichment), "/"),
MethDiff_list = strsplit(as.character(methDiff_combined), "/")
)
}
# final region safety check before saving
if (!all(region_results$region == region_type)) {
stop("Final region validation failed for ", region_type)
}
results_list[[i]] <- region_results
message("  Saved ", nrow(region_results), " rows for ", region_type)
}
# -----------------------------
# Combine all region results
# -----------------------------
non_empty <- results_list[!vapply(results_list, is.null, logical(1))]
if (length(non_empty) == 0) {
message("No GSEA results were generated across any region")
return(tibble())
}
final_results <- bind_rows(non_empty) %>%
mutate(region = as.character(region))
# final global checks
if (any(is.na(final_results$region) | trimws(final_results$region) == "")) {
stop("Some combined results have missing/blank region values")
}
bad_regions <- setdiff(unique(final_results$region), region_values)
if (length(bad_regions) > 0) {
stop("Unexpected region values found in combined results: ", paste(bad_regions, collapse = ", "))
}
final_results
}
# -----------------------------
# Run for experiment 1
# -----------------------------
GSEA_exp1_data <- run_region_gsea(
dm_region_data = exp1_DM_region_data,
GENES_BP = GENES_BP,
TERMs_BP = TERMs_BP,
GENES_MF = GENES_MF,
TERMs_MF = TERMs_MF,
region_col = "region",
score_col = 7,
gene_col = 19,
min_genes = 50,
pvalue_cutoff = 1,
padj_cutoff = 0.1,
seed = 100,
add_methdiff = TRUE
)
# -----------------------------
# Quick audit
# -----------------------------
GSEA_exp1_data %>%
count(region, GO, sort = TRUE)
library(dplyr)
library(tibble)
library(stringr)
library(purrr)
run_region_gsea <- function(
dm_region_data,
GENES_BP,
TERMs_BP,
GENES_MF,
TERMs_MF,
region_col = "region",
score_col = 7,
gene_col = 19,
min_genes = 50,
pvalue_cutoff = 1,
padj_cutoff = 0.1,
seed = 100,
add_methdiff = TRUE
) {
empty_gsea_tbl <- tibble(
ID = character(),
Description = character(),
setSize = integer(),
enrichmentScore = numeric(),
NES = numeric(),
pvalue = numeric(),
p.adjust = numeric(),
qvalue = numeric(),
rank = numeric(),
leading_edge = character(),
core_enrichment = character(),
GO = character(),
region = character(),
methDiff_combined = character(),
Gene_IDs_list = list(),
MethDiff_list = list()
)
empty_audit_tbl <- tibble(
region = character(),
ontology = character(),
n_region_rows = integer(),
n_usable_genes = integer(),
n_gsea_rows = integer(),
n_sig_rows = integer(),
status = character()
)
if (!region_col %in% names(dm_region_data)) {
stop("region_col not found in dm_region_data")
}
region_values <- dm_region_data[[region_col]] %>%
as.character() %>%
trimws()
region_values <- sort(unique(region_values[!is.na(region_values) & region_values != ""]))
if (length(region_values) == 0) {
return(list(
all_results = empty_gsea_tbl,
sig_results = empty_gsea_tbl,
audit = empty_audit_tbl
))
}
run_one_gsea <- function(geneList, TERM2GENE, TERM2NAME, ontology_label, region_type) {
res <- tryCatch(
{
set.seed(seed)
GSEA(
geneList = geneList,
TERM2GENE = TERM2GENE,
TERM2NAME = TERM2NAME,
pvalueCutoff = pvalue_cutoff
)
},
error = function(e) {
message("  ", ontology_label, " failed for ", region_type, ": ", conditionMessage(e))
NULL
}
)
if (is.null(res) || is.null(res@result) || nrow(res@result) == 0) {
return(NULL)
}
as_tibble(res@result) %>%
mutate(
GO = ontology_label,
region = region_type
)
}
all_results_list <- list()
sig_results_list <- list()
audit_list <- list()
idx <- 1L
for (region_type in region_values) {
message("Processing region: ", region_type)
region_data <- dm_region_data %>%
filter(trimws(as.character(.data[[region_col]])) == region_type)
n_region_rows <- nrow(region_data)
if (n_region_rows == 0) {
audit_list[[idx]] <- tibble(
region = region_type,
ontology = c("biological_processes", "molecular_function"),
n_region_rows = 0L,
n_usable_genes = 0L,
n_gsea_rows = 0L,
n_sig_rows = 0L,
status = "no_region_rows"
)
idx <- idx + 1L
next
}
gene_tbl <- tibble(
gene_id = trimws(as.character(region_data[[gene_col]])),
score = suppressWarnings(as.numeric(region_data[[score_col]]))
) %>%
filter(!is.na(gene_id), gene_id != "", !is.na(score)) %>%
group_by(gene_id) %>%
summarise(
score = score[which.max(abs(score))],
.groups = "drop"
) %>%
arrange(desc(score))
n_usable_genes <- nrow(gene_tbl)
if (n_usable_genes < min_genes) {
message("  Skipping ", region_type, " — only ", n_usable_genes, " usable genes")
audit_list[[idx]] <- tibble(
region = region_type,
ontology = c("biological_processes", "molecular_function"),
n_region_rows = n_region_rows,
n_usable_genes = n_usable_genes,
n_gsea_rows = 0L,
n_sig_rows = 0L,
status = "too_few_genes"
)
idx <- idx + 1L
next
}
geneList <- gene_tbl$score
names(geneList) <- gene_tbl$gene_id
geneList <- sort(geneList, decreasing = TRUE)
bp_all <- run_one_gsea(
geneList, GENES_BP, TERMs_BP,
ontology_label = "biological_processes",
region_type = region_type
)
mf_all <- run_one_gsea(
geneList, GENES_MF, TERMs_MF,
ontology_label = "molecular_function",
region_type = region_type
)
region_all <- bind_rows(bp_all, mf_all)
if (nrow(region_all) == 0) {
message("  No GSEA results returned for ", region_type)
audit_list[[idx]] <- tibble(
region = region_type,
ontology = c("biological_processes", "molecular_function"),
n_region_rows = n_region_rows,
n_usable_genes = n_usable_genes,
n_gsea_rows = 0L,
n_sig_rows = 0L,
status = "no_gsea_results"
)
idx <- idx + 1L
next
}
if (!all(region_all$region == region_type)) {
stop("Region assignment failed for ", region_type)
}
region_sig <- region_all %>%
filter(!is.na(p.adjust), p.adjust < padj_cutoff)
if (nrow(region_sig) > 0 && isTRUE(add_methdiff) &&
exists("get_methDiff_data", mode = "function") &&
"core_enrichment" %in% names(region_sig)) {
region_sig <- region_sig %>%
rowwise() %>%
mutate(
methDiff_combined = get_methDiff_data(core_enrichment, region_data)
) %>%
ungroup() %>%
mutate(
Gene_IDs_list = strsplit(as.character(core_enrichment), "/"),
MethDiff_list = strsplit(as.character(methDiff_combined), "/")
)
} else if (nrow(region_sig) > 0) {
region_sig <- region_sig %>%
mutate(
methDiff_combined = NA_character_,
Gene_IDs_list = strsplit(as.character(core_enrichment), "/"),
MethDiff_list = vector("list", n())
)
}
all_results_list[[region_type]] <- region_all
if (nrow(region_sig) > 0) {
sig_results_list[[region_type]] <- region_sig
message("  Saved ", nrow(region_sig), " significant rows for ", region_type)
} else {
message("  No results pass p.adjust cutoff for ", region_type)
}
bp_n_all <- if (is.null(bp_all)) 0L else nrow(bp_all)
mf_n_all <- if (is.null(mf_all)) 0L else nrow(mf_all)
bp_n_sig <- region_sig %>%
filter(GO == "biological_processes") %>%
nrow()
mf_n_sig <- region_sig %>%
filter(GO == "molecular_function") %>%
nrow()
audit_list[[idx]] <- tibble(
region = region_type,
ontology = c("biological_processes", "molecular_function"),
n_region_rows = n_region_rows,
n_usable_genes = n_usable_genes,
n_gsea_rows = c(bp_n_all, mf_n_all),
n_sig_rows = c(bp_n_sig, mf_n_sig),
status = c(
ifelse(bp_n_all > 0, "gsea_run", "no_gsea_results"),
ifelse(mf_n_all > 0, "gsea_run", "no_gsea_results")
)
)
idx <- idx + 1L
}
all_results <- if (length(all_results_list) > 0) {
bind_rows(all_results_list)
} else {
empty_gsea_tbl %>% select(-methDiff_combined, -Gene_IDs_list, -MethDiff_list)
}
sig_results <- if (length(sig_results_list) > 0) {
bind_rows(sig_results_list)
} else {
empty_gsea_tbl
}
audit <- if (length(audit_list) > 0) {
bind_rows(audit_list)
} else {
empty_audit_tbl
}
list(
all_results = all_results,
sig_results = sig_results,
audit = audit
)
}
# Read and prep data
exp1_DM_region_data <- read.table("C:/Users/hamis/OneDrive/Documents/PhD/PhD---omics-analysis-portfolio/Chapter 2/Data/Exp1_DMRs_gene_id_matched.txt", header = TRUE, sep = '\t')
exp1_DM_region_data$region <- as.factor(exp1_DM_region_data$region)
gsea_exp1 <- run_region_gsea(
dm_region_data = exp1_DM_region_data,
GENES_BP = GENES_BP,
TERMs_BP = TERMs_BP,
GENES_MF = GENES_MF,
TERMs_MF = TERMs_MF,
region_col = "region",
score_col = 7,
gene_col = 19,
min_genes = 50,
pvalue_cutoff = 1,
padj_cutoff = 0.1,
seed = 100,
add_methdiff = TRUE
)
