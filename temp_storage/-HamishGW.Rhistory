# combine exp1 + exp2
ORA_combined_compare <- bind_rows(
ORA_exp1_combined_long_semantic %>%
mutate(Experiment = "Exp1"),
ORA_exp2_combined_long_semantic %>%
mutate(Experiment = "Exp2")
)
p_boxes_compare <- ORA_combined_compare %>%
mutate(
Representative_GO = fct_reorder(
Representative_GO,
log2FoldChange,
.fun = median,
.na_rm = TRUE
)
) %>%
ggplot(aes(
x = log2FoldChange,
y = Representative_GO,
fill = Experiment,
colour = Experiment
)) +
geom_vline(
xintercept = 0,
linetype = "dashed",
linewidth = 0.5,
colour = "grey60"
) +
geom_boxplot(
width = 0.7,
outlier.size = 1.5,
outlier.alpha = 0.8,
linewidth = 0.40,
alpha = 0.5,
position = "identity"
) +
labs(
x = "log2 fold-change (LFC) - Ashr Shrunk",
y = NULL,
fill = "Experiment"
) +
scale_y_discrete(labels = \(x) str_wrap(x, width = 45)) +
theme_classic(base_size = 11) +
theme(
axis.text.y = element_text(size = 9, colour = "black"),
axis.text.x = element_text(colour = "black"),
axis.line = element_line(linewidth = 0.5),
plot.margin = margin(5.5, 8, 5.5, 5.5)
) +
facet_wrap(
~GO,
scales = "free",
labeller = labeller(
GO = c(
biological_processes = "Biological Processes",
molecular_functions = "Molecular Functions"
)
)
) +
scale_fill_manual(values = c("Exp1" = "#4C78A8", "Exp2" = "#E45756")) +
scale_colour_manual(values = c("Exp1" = "#14467d", "Exp2" = "#bd1f1e"))
p_boxes_compare
