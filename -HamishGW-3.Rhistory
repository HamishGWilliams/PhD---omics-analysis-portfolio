theme_classic() +
theme(
axis.title.y = element_text(face = "bold", margin = margin(0, 20, 0, 0), size = rel(1.5), colour = "black"),
axis.title.x = element_text(hjust = 0.5, face = "bold", margin = margin(20, 0, 0, 0), size = rel(1.5), colour = "black"),
plot.title = element_text(hjust = 0.5, face = "bold"),
legend.position = "bottom",
legend.text = element_text(size=rel(1.25)),
axis.text = element_text(color = "black",
size = rel(1.0))
) +
labs(
x = expression("ashr-shrunk log"[2] * " Fold Change"),
y = expression("-log"[10] * " p-value"),
colour = NULL
)
make_chapter1_volcano <- function(result_df) {
plotting_df <- result_df |>
mutate(
volcano_status = ifelse(significant, "P-adj <= 0.1", "P-adj > 0.1"),
volcano_status = factor(volcano_status, levels = c("P-adj > 0.1", "P-adj <= 0.1")),
neg_log10_pvalue = -log10(pmax(pvalue, .Machine$double.xmin))
)
ggplot(
data = plotting_df,
aes(x = log2FoldChange, y = neg_log10_pvalue, colour = volcano_status)
) +
geom_point(size = 1.5, alpha = 0.8) +
geom_vline(xintercept = 0, colour = "grey50", linetype = "dashed", linewidth = 0.7) +
scale_colour_manual(
values = c("P-adj > 0.1" = "grey80", "P-adj <= 0.1" = "black"),
drop = FALSE
) +
coord_cartesian(xlim = c(-6, 6), ylim = c(0, 20)) +
scale_x_continuous(breaks = seq(-6, 6, by = 2)) +
scale_y_continuous(breaks = seq(0, 20, by = 5)) +
theme_classic() +
theme(
axis.title.y = element_text(face = "bold", margin = margin(0, 20, 0, 0), size = rel(1.5), colour = "black"),
axis.title.x = element_text(hjust = 0.5, face = "bold", margin = margin(20, 0, 0, 0), size = rel(1.5), colour = "black"),
plot.title = element_text(hjust = 0.5, face = "bold"),
legend.position = "bottom",
legend.text = element_text(size=rel(1.25)),
axis.text = element_text(color = "black",
size = rel(1.0))
) +
labs(
x = expression("ashr-shrunk log"[2] * " Fold Change"),
y = expression("-log"[10] * " p-value"),
colour = NULL
)
}
paired_volcano <- make_chapter1_volcano(
paired_results
) +
theme(legend.position = "bottom")
unpaired_volcano <- make_chapter1_volcano(
unpaired_results
) +
theme(legend.position = "bottom")
# Combine without guides = "collect"
combined_volcano <- (
paired_volcano + unpaired_volcano
) +
patchwork::plot_layout(ncol = 2) +
patchwork::plot_annotation(
tag_levels = "A"
)
combined_volcano
ggsave(file.path(fig_dir, "acute_exp1_volcano_paired_vs_no_clone.png"), combined_volcano, width = 12, height = 6, units = "in", dpi = 900)
