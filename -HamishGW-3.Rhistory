library(dplyr)
library(tibble)
library(ggplot2)
library(gridExtra)
library(grid)
library(cowplot)
padj_cutoff <- 0.1
prepare_deg_results <- function(results_df) {
results_df <- as.data.frame(results_df)
# Add gene IDs from row names if not already present
if (!"gene_id" %in% colnames(results_df)) {
results_df <- results_df %>%
rownames_to_column("gene_id")
}
results_df %>%
mutate(
significant = !is.na(padj) & padj < padj_cutoff,
direction = case_when(
significant & log2FoldChange > 0 ~ "(+)LFC",
significant & log2FoldChange < 0 ~ "(-)LFC",
TRUE ~ "Not significant"
)
)
}
paired_df <- prepare_deg_results(paired_results)
unpaired_df <- prepare_deg_results(unpaired_results)
paired_deg_ids <- paired_df %>%
filter(significant) %>%
pull(gene_id)
unpaired_deg_ids <- unpaired_df %>%
filter(significant) %>%
pull(gene_id)
shared_deg_ids <- intersect(paired_deg_ids, unpaired_deg_ids)
deg_summary_table <- tibble(
Design = c("~ Clone + Group", "~ Group"),
Total = c(
length(paired_deg_ids),
length(unpaired_deg_ids)
),
`(+)LFC` = c(
sum(paired_df$significant & paired_df$log2FoldChange > 0, na.rm = TRUE),
sum(unpaired_df$significant & unpaired_df$log2FoldChange > 0, na.rm = TRUE)
),
`(-)LFC` = c(
sum(paired_df$significant & paired_df$log2FoldChange < 0, na.rm = TRUE),
sum(unpaired_df$significant & unpaired_df$log2FoldChange < 0, na.rm = TRUE)
),
Shared = rep(length(shared_deg_ids), 2),
Unique = c(
length(setdiff(paired_deg_ids, unpaired_deg_ids)),
length(setdiff(unpaired_deg_ids, paired_deg_ids))
)
)
deg_summary_table
table_theme <- gridExtra::ttheme_minimal(
base_size = 12,
base_family = "sans",
core = list(
fg_params = list(
hjust = c(0, rep(0.5, 5)),
x = c(0.05, rep(0.5, 5)),
fontsize = 12
),
bg_params = list(
fill = c("#F3F6F8", "white"),
col = NA
)
),
colhead = list(
fg_params = list(
fontface = "bold",
fontsize = 12,
hjust = c(0, rep(0.5, 5)),
x = c(0.05, rep(0.5, 5))
),
bg_params = list(
fill = "#D9E5EF",
col = NA
)
)
)
summary_grob <- gridExtra::tableGrob(
deg_summary_table,
rows = NULL,
theme = table_theme
)
# Add a title above the table
summary_title <- grid::textGrob(
"Differentially expressed gene summary",
x = 0,
hjust = 0,
gp = grid::gpar(
fontsize = 13,
fontface = "bold"
)
)
summary_panel <- gridExtra::arrangeGrob(
summary_title,
summary_grob,
ncol = 1,
heights = c(0.25, 1)
)
paired_volcano_no_legend <- paired_volcano +
theme(
legend.position = "none",
plot.margin = margin(8, 8, 8, 8)
)
unpaired_volcano_no_legend <- unpaired_volcano +
theme(
legend.position = "none",
plot.margin = margin(8, 8, 8, 8)
)
common_legend <- cowplot::get_legend(
paired_volcano +
theme(
legend.position = "bottom",
legend.justification = "center"
)
)
volcano_panel <- cowplot::plot_grid(
paired_volcano_no_legend,
unpaired_volcano_no_legend,
labels = c("A", "B"),
label_fontface = "bold",
label_size = 14,
ncol = 2,
align = "hv",
axis = "tblr"
)
volcano_with_legend <- cowplot::plot_grid(
volcano_panel,
common_legend,
ncol = 1,
rel_heights = c(1, 0.08)
)
final_volcano_figure <- cowplot::plot_grid(
volcano_with_legend,
summary_panel,
ncol = 1,
rel_heights = c(1, 0.25)
)
final_volcano_figure
